# 이 파일을 .env 로 복사해 값을 채운다.
# .env 는 저장소 추적과 이미지 빌드 컨텍스트에서 모두 제외한다(.gitignore, .dockerignore).

# ── 저장소 ──────────────────────────────────────────────
POSTGRES_USER=history
POSTGRES_PASSWORD=change-me-local
REDIS_PASSWORD=change-me-local
MINIO_ROOT_USER=history
MINIO_ROOT_PASSWORD=change-me-local

# ── 서비스 간 호출 검증 ───────────────────────
# 게이트웨이를 거치지 않은 직접 호출을 막는 내부 API 키
INTERNAL_API_KEY=change-me-local

# ── JWT ──────────────────────────────────────
# 비워 두면 auth-service 가 기동 시 임시 RSA 키를 만들고 경고를 남긴다.
# 재시작하면 키가 바뀌어 기존 토큰이 무효가 되므로 로컬 개발에서만 비워 둔다.
JWT_PRIVATE_KEY=
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600

IMAGE_TAG=dev

GEMINI_API_KEY=
GROQ_API_KEY=

# ── 실시간 알림 ──────────────────────────────────
# 상충 감지 및 거버넌스 이벤트 실시간 알림 채널별 설정 (활성화된 채널만 전송)
NOTIFICATION_ENABLED=true
FRONTEND_BASE_URL=http://localhost:5173
NOTIFICATION_MIN_SEVERITY=0.70

# Slack Webhook (Block Kit)
SLACK_WEBHOOK_ENABLED=false
SLACK_WEBHOOK_URL=

# MS Teams Webhook (MessageCard)
TEAMS_WEBHOOK_ENABLED=false
TEAMS_WEBHOOK_URL=

# Email (SMTP) 알림
EMAIL_NOTIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@company.com
EMAIL_TO=governance-alerts@company.com